{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arr.pub/schema/paper.schema.json",
  "title": "ARR paper metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "title",
    "abstract",
    "authors",
    "date",
    "status",
    "license",
    "source_of_truth",
    "ai_assistance",
    "screening",
    "verification"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^ARR-[0-9]{4}-[0-9]{6}$"},
    "version": {"type": "string", "pattern": "^v[1-9][0-9]*$"},
    "title": {"type": "string", "minLength": 10, "maxLength": 300},
    "abstract": {"type": "string", "minLength": 50, "maxLength": 5000},
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {"type": "string", "minLength": 2},
          "orcid": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{4}-[0-9]{4}-[0-9]{3}[0-9X]$"},
          "affiliation": {"type": "string"}
        }
      }
    },
    "date": {"type": "string", "format": "date"},
    "status": {"enum": ["accepted", "corrected", "withdrawn"]},
    "license": {"type": "string", "minLength": 2},
    "source_of_truth": {"enum": ["paper.tex", "paper.md"]},
    "keywords": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "subjects": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "doi": {"type": "string"},
    "release_url": {"type": "string", "format": "uri"},
    "supersedes": {"type": "string"},
    "ai_assistance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["used", "statement"],
      "properties": {
        "used": {"type": "boolean"},
        "statement": {"type": "string", "minLength": 10},
        "systems": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "screening": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "status", "completed_at", "critical_objections_unresolved", "human_signoff", "evaluators"],
      "properties": {
        "protocol": {"type": "string"},
        "status": {"const": "pass"},
        "completed_at": {"type": "string", "format": "date"},
        "critical_objections_unresolved": {"const": 0},
        "human_signoff": {"const": true},
        "evaluators": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["provider", "model_id", "outcome", "report", "involved_in_creation"],
            "properties": {
              "provider": {"type": "string", "minLength": 2},
              "model_id": {"type": "string", "minLength": 2},
              "outcome": {"const": "pass"},
              "report": {"type": "string", "minLength": 3},
              "involved_in_creation": {"type": "boolean"}
            }
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "bibliography", "source_integrity", "reproducibility", "lean4"],
      "properties": {
        "protocol": {"type": "string"},
        "bibliography": {"enum": ["pass", "partial", "not_applicable"]},
        "source_integrity": {"enum": ["pass"]},
        "reproducibility": {"enum": ["pass", "partial", "not_applicable"]},
        "lean4": {"enum": ["L0", "L1", "L2", "L3", "not_applicable"]}
      }
    }
  }
}
