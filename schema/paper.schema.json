{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arr-research.github.io/schema/paper.schema.json",
  "$comment": "SPDX-License-Identifier: CC0-1.0",
  "title": "ARR public research record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "version_id",
    "id",
    "version",
    "title",
    "abstract",
    "authors",
    "date",
    "status",
    "licenses",
    "source_of_truth",
    "deposit",
    "integrity",
    "ai_assistance",
    "screening",
    "verification"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "record_id": {
      "type": "string",
      "pattern": "^arr:record:[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "version_id": {
      "type": "string",
      "pattern": "^arr:version:[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "id": {"type": "string", "pattern": "^ARR-[0-9]{4}-[0-9A-HJKMNP-TV-Z]{16}$"},
    "version": {"type": "string", "pattern": "^v[1-9][0-9]*$"},
    "title": {"type": "string", "minLength": 10, "maxLength": 300},
    "abstract": {"type": "string", "minLength": 50, "maxLength": 5000},
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {"type": "string", "minLength": 2},
          "orcid": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{4}-[0-9]{4}-[0-9]{3}[0-9X]$"},
          "affiliation": {"type": "string"}
        }
      }
    },
    "date": {"type": "string", "format": "date"},
    "status": {"enum": ["accepted", "corrected", "withdrawn"]},
    "licenses": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manuscript", "metadata", "code", "data"],
      "properties": {
        "manuscript": {"type": "string", "minLength": 2},
        "metadata": {"const": "CC0-1.0"},
        "code": {"type": "array", "items": {"$ref": "#/$defs/licensedPath"}},
        "data": {"type": "array", "items": {"$ref": "#/$defs/licensedPath"}}
      }
    },
    "source_of_truth": {"enum": ["paper.tex", "paper.md"]},
    "keywords": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "subjects": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "doi": {"type": "string"},
    "release_url": {"type": "string", "format": "uri"},
    "supersedes_version_id": {"type": "string"},
    "deposit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["depositor_name", "relationship", "deposit_authorized", "third_party_material_disclosed", "terms_version"],
      "properties": {
        "depositor_name": {"type": "string", "minLength": 2},
        "relationship": {"enum": ["author", "rights_holder", "authorized_agent"]},
        "deposit_authorized": {"const": true},
        "third_party_material_disclosed": {"type": "boolean"},
        "terms_version": {"type": "string", "minLength": 3}
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "manifest"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "manifest": {"const": "MANIFEST.sha256"}
      }
    },
    "ai_assistance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["used", "statement"],
      "properties": {
        "used": {"type": "boolean"},
        "statement": {"type": "string", "minLength": 10},
        "systems": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "screening": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "status", "critical_objections_unresolved", "human_signoff", "evaluators"],
      "properties": {
        "protocol": {"type": "string", "minLength": 3},
        "status": {"enum": ["not_assessed", "pass", "fail"]},
        "completed_at": {"type": "string", "format": "date"},
        "critical_objections_unresolved": {"type": "integer", "minimum": 0},
        "human_signoff": {"const": true},
        "evaluators": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["provider", "model_id", "outcome", "report", "involved_in_creation"],
            "properties": {
              "provider": {"type": "string", "minLength": 2},
              "model_id": {"type": "string", "minLength": 2},
              "outcome": {"enum": ["pass", "concerns", "fail"]},
              "report": {"type": "string", "minLength": 3},
              "involved_in_creation": {"type": "boolean"}
            }
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "bibliography", "source_integrity", "reproducibility", "lean4"],
      "properties": {
        "protocol": {"type": "string", "minLength": 3},
        "bibliography": {"enum": ["pass", "partial", "not_assessed", "not_applicable"]},
        "source_integrity": {"const": "pass"},
        "reproducibility": {"enum": ["pass", "partial", "not_assessed", "not_applicable"]},
        "lean4": {"enum": ["L0", "L1", "L2", "L3", "not_assessed", "not_applicable"]},
        "report": {"type": "string"}
      }
    }
  },
  "$defs": {
    "licensedPath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "spdx"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "spdx": {"type": "string", "minLength": 2}
      }
    }
  }
}
