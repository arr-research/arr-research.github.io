{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Preserved historical exact-PDF model evidence, excluded from current aggregate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "license",
    "mode",
    "reviews"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "license": {
      "const": "CC-BY-4.0"
    },
    "mode": {
      "const": "historical_evidence_only"
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "record_id",
          "paper_id",
          "version_id",
          "canonical_sha256",
          "recorded_at",
          "sources"
        ],
        "properties": {
          "record_id": {
            "type": "string",
            "pattern": "^arr:preserved-review:"
          },
          "paper_id": {
            "type": "string",
            "pattern": "^ARR-"
          },
          "version_id": {
            "type": "string",
            "pattern": "^arr:version:"
          },
          "canonical_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "recorded_at": {
            "type": "string",
            "format": "date-time"
          },
          "sources": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "verdict",
              "report",
              "receipt"
            ],
            "properties": {
              "verdict": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "sha256"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^papers/",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              },
              "report": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "sha256"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^papers/",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              },
              "receipt": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "sha256"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^papers/",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
