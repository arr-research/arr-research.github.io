{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arr-research.github.io/schema/editorial-highlight.schema.json",
  "title": "ARR editorial highlight",
  "type": "object",
  "additionalProperties": false,
  "required": ["paper_id", "version", "headline", "why_it_matters", "strengths", "caveats", "signed_by", "updated_at"],
  "properties": {
    "paper_id": {"type": "string", "pattern": "^ARR-[0-9]{4}-[0-9A-HJKMNP-TV-Z]{16}$"},
    "version": {"type": "string", "pattern": "^v[1-9][0-9]*$"},
    "headline": {"type": "string", "minLength": 10, "maxLength": 180},
    "why_it_matters": {"type": "string", "minLength": 40, "maxLength": 1600},
    "strengths": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "minLength": 8, "maxLength": 500}},
    "caveats": {"type": "array", "maxItems": 8, "items": {"type": "string", "minLength": 8, "maxLength": 500}},
    "signed_by": {"type": "string", "minLength": 2, "maxLength": 120},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
