{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arr-research.github.io/schema/submission-receipt.schema.json",
  "$comment": "SPDX-License-Identifier: CC0-1.0",
  "title": "ARR private intake receipt",
  "description": "A receipt proves intake of bytes; it is not publication, acceptance, priority, endorsement, or indefinite-storage commitment.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "submission_id", "received_at", "content_sha256", "byte_size", "state", "retention_until", "disclaimer"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "submission_id": {"type": "string", "pattern": "^arr:submission:[0-9a-f-]{36}$"},
    "received_at": {"type": "string", "format": "date-time"},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "byte_size": {"type": "integer", "minimum": 1},
    "state": {"enum": ["received", "quarantined", "eligible", "under_assessment", "declined", "expired", "removed", "legal_hold", "accepted_for_publication"]},
    "retention_until": {"type": "string", "format": "date-time"},
    "disclaimer": {"const": "Receipt is not ARR publication or acceptance."}
  }
}
