  "display_equations": 51,
  "math_fragments": 382,
  "equations": [
    {
      "tag": "1",
      "tex": "\\kappa_d(F)=\\frac12\\min\\{\\|C\\|_{HS}^2:CC^*-C^*C=2F\\},\\qquad P=\\operatorname{tr}F_+=\\tfrac12\\|F\\|_1.",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "2",
      "tex": "\\boxed{P\\leq\\kappa_d(F)\\leq\\frac{M+1}{2}P.}",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "3",
      "tex": "\\phi_d(\\lambda):=\\kappa_d(\\operatorname{diag}\\lambda)",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "4",
      "tex": "(s,-s^{\\mathrm{rev}},\\lambda),",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "5",
      "tex": "\\kappa_d(F)=\\sum_{j=1}^n j b_j,",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "6",
      "tex": "I_\\ell=\\{1,\\ldots,\\ell\\},\\qquad J_\\ell=K_\\ell=\\{1,d-\\ell+2,\\ldots,d\\},\\quad 1\\leq\\ell\\leq n.",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "7",
      "tex": "C e_{\\ell+1}=\\sqrt{2\\sum_{j\\geq\\ell}b_j}\\,e_\\ell",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "8",
      "tex": "\\kappa_d(E_{k,l})\\leq c_{kl}:=\\frac{(k+l)(k+l-g)}{2kl}.",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "9",
      "tex": "g\\frac{g}{kl}\\frac{L(L-1)}2=c_{kl}.",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "10",
      "tex": "c_{kl}<\\frac{\\max(k,l)+1}{2}.",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "11",
      "tex": "kl(l+1)-(k+l)(k+l-1) =(k-1)\\{k(k-2)+t(2k-1)+t^2\\}.",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "12",
      "tex": "\\alpha_k=k(a_k-a_{k+1}),\\qquad\\beta_l=l(b_l-b_{l+1}).",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "13",
      "tex": "\\lambda(F)=\\sum_{k=1}^m\\sum_{l=1}^n\\alpha_k\\beta_l\\lambda(E_{k,l}),",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "14",
      "tex": "\\frac{\\kappa_d(F)}P\\leq\\sum_{k,l}\\alpha_k\\beta_l c_{kl}\\leq\\frac{M+1}{2}.",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "15",
      "tex": "\\frac{M+1}{2}P-\\kappa_d(F) \\geq Pmn a_m b_n\\left(\\frac{M+1}{2}-c_{mn}\\right)>0.",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "16",
      "tex": "H=(\\max(m,n)+1)/2,\\qquad \\delta=H-\\kappa_d(F)/P,\\qquad h_{kl}=H-c_{kl}.",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "17",
      "tex": "\\frac{n-m}{4(2-1/m-1/n)}D\\ \\leq\\ \\delta\\ \\leq\\ \\frac{n-1}{2}D.",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "18",
      "tex": "D_* = \\min\\{\\|a-e_N\\|_1+\\|b-u_N\\|_1,\\ \\|a-u_N\\|_1+\\|b-e_N\\|_1\\}.",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "19",
      "tex": "\\gamma_N=\\min_{(k,l)\\notin\\{(1,N),(N,1)\\}}\\left(\\frac{N+1}{2}-c_{kl}\\right),",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "20",
      "tex": "\\frac{\\gamma_N}{4(1-1/N)}D_*\\leq\\delta\\leq\\frac{N-1}{2}D_*.",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "21",
      "tex": "s_j\\geq a_j,\\qquad s_j\\geq b_j,\\qquad \\kappa_d(F)\\geq\\sum_j\\max(a_j,b_j),",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "22",
      "tex": "s_l\\geq a_1-\\sum_{j<l}b_j\\qquad (1\\leq l\\leq n).",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "23",
      "tex": "\\kappa_d(F)\\geq\\sum_{j=1}^n j b_j-(n-1)(1-a_1).",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "24",
      "tex": "\\delta\\leq\\frac{n-1}{2}\\|b-u_n\\|_1+\\frac{n-1}{2}\\|a-e_m\\|_1.",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "25",
      "tex": "d_{kl}\\leq C_{mn}h_{kl},\\qquad C_{mn}=\\frac{4(2-1/m-1/n)}{n-m}.",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "26",
      "tex": "2q\\big((n+1)/2-c^1_{kl}\\big)-(n-k)(2-1/k-l/n) =-\\frac{(k-1)(l-1)}{k^2ln}B_{kn}(l),",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "27",
      "tex": "B_{kn}(l)=k^2l-2k^2n+k^2-kln+kl+kn+ln.",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "28",
      "tex": "B_{kn}(1)=-(2k^2-1)(n-1)+k+1<0,",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "29",
      "tex": "B_{kn}(n)=-(k+n)(kn-k-n)<0.",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "30",
      "tex": "D\\leq\\sum_{k,l}\\alpha_k\\beta_l d_{kl} \\leq C_{mn}\\sum_{k,l}\\alpha_k\\beta_l h_{kl}\\leq C_{mn}\\delta.",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "31",
      "tex": "D_*\\leq2(1-1/N)(2-S).",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "32",
      "tex": "4w\\leq(x+v)^2+(y+u)^2\\leq S(x+y+u+v)\\leq2S.",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "33",
      "tex": "a=(1-\\varepsilon,\\varepsilon,0,\\ldots,0),\\qquad b=u_n.",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "34",
      "tex": "\\kappa_d(F)=\\frac{n+1}{2}-(n-1)\\varepsilon.",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "35",
      "tex": "\\boxed{\\frac{17}{36}D_*\\leq\\delta\\leq D_*.}",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "36",
      "tex": "e=(1,0,0),\\qquad p=(1/2,1/2,0),\\qquad u=(1/3,1/3,1/3).",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "37",
      "tex": "q(e)=-4/3,\\qquad q(v)=0,\\qquad q(p)=1/3,\\qquad q(u)=4/3",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "38",
      "tex": "(w,v),\\quad (r,p),\\quad (t,p),",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "39",
      "tex": "w=(2/3,1/6,1/6),\\quad r=(7/12,5/24,5/24),\\quad t=(7/12,1/3,1/12).",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "40",
      "tex": "\\sum_{i\\in I}s_i-\\sum_{j\\in J}s_{7-j}\\geq\\sum_{k\\in K}\\lambda_k.",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "41",
      "tex": "\\sum_i s_i+\\frac{17}{36}D_*\\leq2.",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "42",
      "tex": "\\kappa_d\\geq\\frac7{12}+\\frac12+\\frac5{24}=\\frac{31}{24}.",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "43",
      "tex": "\\frac{31}{24}-\\frac{\\eta}{2}\\leq\\kappa_d\\leq\\frac{31}{24}+\\frac{17\\eta}{18}.",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "44",
      "tex": "\\Pi(\\alpha,\\beta)=\\{\\pi\\geq0:\\ \\sum_l\\pi_{kl}=\\alpha_k,\\ \\sum_k\\pi_{kl}=\\beta_l\\},\\qquad T(\\alpha,\\beta)=\\min_{\\pi\\in\\Pi(\\alpha,\\beta)}\\sum_{k,l}\\pi_{kl}c_{kl}.",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "45",
      "tex": "\\frac{\\kappa_d(F)}P\\leq T(\\alpha,\\beta)\\leq\\sum_{k,l}\\alpha_k\\beta_lc_{kl}\\leq H.",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "46",
      "tex": "T(\\alpha,\\beta)=\\max_{u_k+v_l\\leq c_{kl}}\\left(\\sum_k\\alpha_k u_k+\\sum_l\\beta_l v_l\\right).",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "47",
      "tex": "\\sum_{k,l}\\pi_{kl}(c_{kl}-u_k-v_l)\\geq0.",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "48",
      "tex": "T(\\alpha,\\beta)\\leq\\sum_{k,l}\\alpha_k\\beta_lc_{kl}-\\min(\\alpha_1\\beta_2,\\alpha_2\\beta_1)",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "49",
      "tex": "T=1+\\tfrac12|x-y|.",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "50",
      "tex": "\\Delta=\\frac\\rho2-\\frac{\\kappa_d(F)}P.",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "51",
      "tex": "\\frac N4\\mathcal L\\leq\\Delta\\leq\\frac{N-1}{2}\\mathcal L, \\qquad \\mathcal L\\leq\\frac{4\\Delta}{\\rho-1}.",
      "lines": 1,
      "scale": 1
    }
  ]
}
