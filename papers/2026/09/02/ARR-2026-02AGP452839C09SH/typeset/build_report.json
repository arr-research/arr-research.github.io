      "tex": "C=(I-U)(I-V)=I-U-V+UV.",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "12",
      "tex": "CC^*=9P_{\\{x\\ne0,\\ y\\ne0\\}},\\qquad  \\operatorname{rank}C=4d/9,\\qquad \\operatorname{Tr}CC^*=4d.",
