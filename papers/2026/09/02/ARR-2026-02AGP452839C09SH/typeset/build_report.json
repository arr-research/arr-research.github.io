    {
      "tag": "1",
      "tex": "U=X^{d/3},\\qquad V=Z^{d/3},\\qquad \\omega=e^{2\\pi i/3}.",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "2",
      "tex": "P_L=\\sum_{(x,y)\\in L}P_{E_{x,y}}      =\\frac13\\sum_{t=0}^2\\omega^{-ct}(U^aV^b)^t,  \\qquad \\sigma_L=\\frac3dP_L.",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "3",
      "tex": "\\rho=\\sum_{L\\in S}\\lambda_L\\sigma_L,  \\qquad \\lambda_L>0,\\qquad \\sum_{L\\in S}\\lambda_L=1,",
      "lines": 1,
      "scale": 1
