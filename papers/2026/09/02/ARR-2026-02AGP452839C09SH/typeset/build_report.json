    {
      "tag": "5",
      "tex": "\\ell_{\\min}^{\\rm exact}(d,5d/9)=3,  \\qquad \\ell_{\\min}^{\\rm exact}(d,4d/9)=4.",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "6",
      "tex": "\\rho=\\sum_j C_jC_j^*,\\qquad s_W(C_j)\\le\\ell.",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": null,
      "tex": "|A\\rangle\\!\\rangle=\\sum_{i=0}^{d-1}\\sum_{\\alpha=1}^r  A_{i\\alpha}|i\\rangle\\otimes|\\alpha\\rangle.",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": null,
      "tex": "\\sum_g|W_gB\\rangle\\!\\rangle\\langle\\!\\langle W_gB|  =dI_d\\otimes(B^*B)^T.",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "7",
      "tex": "M_{j,g}=\\frac1d|W_gB_j\\rangle\\!\\rangle                  \\langle\\!\\langle W_gB_j|,  \\qquad \\sum_{j,g}M_{j,g}=I_{dr}.",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "8",
      "tex": "\\det(cI+aA+bB)=c^q-(-1)^q(a^q s_0+b^q t_0).",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "9",
      "tex": "CC^*=\\alpha P_L+\\beta P_M,  \\qquad \\alpha,\\beta\\ge0,\\quad \\alpha+\\beta>0,",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": null,
      "tex": "\\left\\{\\frac12,\\frac13,\\frac16,\\frac56,\\frac23,\\frac12\\right\\}.",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "10",
      "tex": "(I-T)(I-T)^*=3(I-P_{T=1}).",
      "lines": 1,
      "scale": 1
    },
    {
