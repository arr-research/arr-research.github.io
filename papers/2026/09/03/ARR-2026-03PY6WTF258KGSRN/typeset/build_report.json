  "display_equations": 47,
  "math_fragments": 189,
  "equations": [
    {
      "tag": null,
      "tex": "f(1)\\in\\mathbb C e_2,\\qquad f(e^{-ia}),f(e^{ib})\\in\\mathbb C e_1, \\qquad 0<a,b<\\pi.",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "1",
      "tex": "\\mathcal T(S)=\\max_\\phi\\operatorname{tr}\\left[-iS(e^{i\\phi})^* \\frac{dS(e^{i\\phi})}{d\\phi}\\right].",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "2",
      "tex": "u=\\cot(a/2),\\quad v=\\cot(b/2),\\quad m=\\frac{v-u}{2},\\quad d=\\frac{u+v}{2}>0.",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "3",
      "tex": "A=Y^2-2V+2d^2,\\quad B=Y^2K,\\quad C=V^2+Y^2K^2-d^4.",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "4",
      "tex": "Y>0,\\qquad V>K^2,\\qquad \\begin{pmatrix}A&B\\\\B&C\\end{pmatrix}\\succeq0.",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "5",
      "tex": "\\tau(t)= \\frac{Y[1+(t+m)^2](t^2+2Kt+V)} {(t^2-V)^2+Y^2(t+K)^2},\\qquad \\tau(\\infty)=Y.",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "6",
      "tex": "R_T(t)=T\\bigl[(t^2-V)^2+Y^2(t+K)^2\\bigr] -Y[1+(t+m)^2](t^2+2Kt+V)",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "7",
      "tex": "\\mathcal T_2(a,b)=2 \\quad\\Longleftrightarrow\\quad a=b\\geq\\frac{\\pi}{2}.",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "8",
      "tex": "f(t)=\\frac{1}{h(t)}\\begin{pmatrix}p(t)\\\\q(t)\\end{pmatrix}, \\qquad q(t)=t^2-d^2,\\qquad \\deg p\\leq1.",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "9",
      "tex": "|h(t)|^2=q(t)^2+|p(t)|^2\\quad(t\\in\\mathbb R).",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "10",
      "tex": "h(t)=t^2-V-iY(t+K),\\qquad V,Y,K\\in\\mathbb R.",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": null,
      "tex": "V-K^2=\\eta_1\\eta_2 \\left(1+\\frac{4r^2}{(\\eta_1+\\eta_2)^2}\\right)>0.",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "11",
      "tex": "|p(t)|^2=At^2+2Bt+C,",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "12",
      "tex": "p(t)=\\sqrt A\\,t+\\frac B{\\sqrt A} +i\\sqrt{C-\\frac{B^2}{A}};",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "13",
      "tex": "S_2(t)=\\frac1{h(t)} \\begin{pmatrix}p(t)&-q(t)\\\\q(t)&p^*(t)\\end{pmatrix}.",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "14",
      "tex": "AC-B^2=(V-d^2) \\left[Y^2(V+d^2-2K^2)-2(V^2-d^4)\\right].",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "15",
      "tex": "Y>0,\\qquad K^2<\\frac{V+d^2}{2},\\qquad Y^2\\geq\\frac{2(V^2-d^4)}{V+d^2-2K^2}.",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": null,
      "tex": "r_4=T-Y,\\qquad r_3=-2Y(K+m),",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": null,
      "tex": "r_2=T(Y^2-2V)-Y(V+4mK+m^2+1),",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": null,
      "tex": "r_1=2TY^2K-2Y[mV+K(m^2+1)],",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "16",
      "tex": "r_0=T(V^2+Y^2K^2)-YV(m^2+1).",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "17",
      "tex": "G_\\lambda= \\begin{pmatrix} r_0&r_1/2&\\lambda\\\\ r_1/2&r_2-2\\lambda&r_3/2\\\\ \\lambda&r_3/2&r_4 \\end{pmatrix}\\succeq0.",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": null,
      "tex": "P_0=\\frac{1+m^2+d^2}{2d},",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "18",
      "tex": "\\mathcal T_{\\rm dbl}=2\\left(P_0+\\sqrt{P_0^2-1}\\right).",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "19",
      "tex": "\\tau(\\phi)=\\sum_{j=1}^2 \\frac{1-|\\alpha_j|^2}{|e^{i\\phi}-\\alpha_j|^2}.",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": null,
      "tex": "\\alpha_1+\\alpha_2=0,\\qquad \\alpha_1^2+\\alpha_2^2=0,",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "20",
      "tex": "q_z(z)=c_0(z-e^{-ia})(z-e^{ib}).",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": null,
      "tex": "\\alpha=\\frac{a+b}{2},\\qquad \\beta=\\frac{b-a}{2}.",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "21",
      "tex": "|(e^{i\\phi}-e^{-ia})(e^{i\\phi}-e^{ib})| =2|\\cos(\\phi-\\beta)-\\cos\\alpha|.",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": null,
      "tex": "V=1,\\quad Y=2,\\quad K=0,\\quad h=(t-i)^2,\\quad q=t^2-d^2,",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "22",
      "tex": "p(t)=\\sqrt{2+2d^2}\\,t+i\\sqrt{1-d^4}.",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "23",
      "tex": "M(a,b)=\\frac{1+|\\cos\\alpha|}{\\cos\\beta-\\cos\\alpha}\\geq1, \\qquad \\eta=\\frac{M-1}{M+1}\\in[0,1).",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "24",
      "tex": "\\mathcal T_2(a,b)\\geq 2+\\frac{\\sqrt{9+8\\eta}-3}{2}.",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": null,
      "tex": "|\\alpha_1+\\alpha_2|\\leq\\varepsilon,\\qquad |\\alpha_1^2+\\alpha_2^2|\\leq\\varepsilon.",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": null,
      "tex": "|\\alpha_1\\alpha_2|\\leq\\frac{\\varepsilon^2+\\varepsilon}{2}.",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "25",
      "tex": "|h_z(z)-1|\\leq r, \\qquad r=\\frac{\\varepsilon^2+3\\varepsilon}{2}.",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": null,
      "tex": "M\\leq\\frac{\\max_{|z|=1}|h_z(z)|}{|h_z(1)|}.",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "26",
      "tex": "\\mathcal T_2(a,b)\\geq\\max\\left\\{2,\\frac\\pi a,\\frac\\pi b\\right\\}.",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "27",
      "tex": "x^3-(4w+1)x^2-(w^2+4w)x+w^2=0.",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "28",
      "tex": "V=w,\\quad K=0,\\quad Y=\\frac{x-w}{\\sqrt x},\\qquad T_* =\\frac{(x+1)(x+w)}{2\\sqrt x(x-w)}.",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "29",
      "tex": "\\mathcal T_2(a,a)\\leq T_*<2\\cot(a/2).",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": null,
      "tex": "z^3-(w+1)z^2-6w(w+1)z-4w^2(w+1).",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "30",
      "tex": "w=\\frac{r^2+4r-1}{r(r^2-4r-1)}.",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": null,
      "tex": "-\\frac{(r-1)^2(r^2+10r+1)}{r^2(r^2-4r-1)^2}<0.",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "31",
      "tex": "R_{T_*}(t)=(T_*-Y)(t^2-x)^2.",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "32",
      "tex": "4w-T_*^2= -\\frac{(r^2-6r+1)(r^3+6r^2+9r-4)} {r(r^2-4r-1)(r^2+4r-1)}>0",
      "lines": 1,
      "scale": 1
    },
    {
      "tag": "33",
      "tex": "Y=\\frac{4\\sqrt{11}}5,\\qquad T_* =\\frac9{\\sqrt{11}}, \\qquad R_{T_*}(t)=\\frac{(t^2-11)^2}{5\\sqrt{11}}.",
      "lines": 1,
      "scale": 1
    }
  ]
}
