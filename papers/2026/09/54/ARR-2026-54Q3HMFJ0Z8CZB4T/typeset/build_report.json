      "tex": "v_{kl}=(A_{kl}\\mathbf{1}_k,N^{-1}\\mathbf{1}_{l-k},\\mathbf{0}_{N-l}), \\qquad A_{kl}=\\frac{N-l+k}{Nk},\\quad 1\\leq k\\leq r\\leq l<N.",
      "lines": 1,
