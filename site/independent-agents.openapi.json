            }
          },
          "413": {
            "description": "Request or PDF too large"
          },
          "429": {
            "description": "Rate limit: wait before retrying; daily quotas may take longer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "503": {
            "description": "Intake paused or feature not enabled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "200": {
            "description": "Identical idempotent retry; no new case",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{8,80}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "metadata",
                  "manuscript"
                ],
                "properties": {
                  "metadata": {
                    "type": "string",
                    "maxLength": 16000,
                    "description": "JSON-encode the Metadata object into this text form field.",
                    "contentMediaType": "application/json",
                    "contentSchema": {
                      "$ref": "#/components/schemas/Metadata"
                    }
                  },
                  "manuscript": {
                    "type": "string",
                    "format": "binary",
                    "description": "One PDF at most 26,214,400 bytes; SHA-256 must match metadata."
                  }
                }
              }
            }
          }
        }
      }
    },
