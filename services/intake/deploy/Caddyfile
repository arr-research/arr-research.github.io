submit.airr.science {
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Robots-Tag "noindex, nofollow, noarchive"
        Cache-Control "no-store"
        Referrer-Policy "no-referrer"
        X-Content-Type-Options "nosniff"
        -Server
    }
    request_body {
        max_size 27MB
    }
    # Operational probes are only available to the local reverse proxy/monitor.
    @probes path /healthz /readyz
    respond @probes 404
    reverse_proxy 127.0.0.1:8000 {
        header_up Host submit.airr.science
        header_up X-Forwarded-Host submit.airr.science
        header_up X-Forwarded-Proto https
        header_up X-Forwarded-For {remote_host}
        health_uri /healthz
        health_interval 30s
        health_timeout 5s
        transport http {
            dial_timeout 5s
            response_header_timeout 180s
        }
    }
    # Access logging is deliberately not enabled: emailed URLs contain one-use tokens.
}
